{
  "name": "cinema-booking-frontend",
  "version": "1.0.0",
  "description": "Hệ Thống Xem Và Đặt Vé Phim - Frontend Client",
  "type": "module",
  "private": true,
  "author": "Your Company Name",
  "license": "Proprietary",
  "keywords": [
    "cinema",
    "movie",
    "booking",
    "ticket",
    "react",
    "vite"
  ],
  "homepage": "https://your-domain.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/cinema-booking-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/cinema-booking-frontend/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .js,.jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "lint:staged": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:src": "prettier --write \"src/**/*.{js,jsx,json,css,md}\"",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "clean": "rm -rf dist node_modules package-lock.json",
    "clean:dist": "rm -rf dist",
    "prebuild": "npm run clean:dist",
    "postinstall": "echo '✨ Dependencies installed successfully!'"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.106.1",
    "animate.css": "^4.1.1",
    "axios": "^1.7.7",
    "date-fns": "^3.0.0",
    "jwt-decode": "^4.0.0",
    "prop-types": "^15.8.1",
    "qrcode.react": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.26.0",
    "sweetalert2": "^11.14.0"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.106.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.0.5",
    "@vitest/ui": "^2.0.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-react": "^7.36.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "husky": "^9.1.5",
    "jsdom": "^25.0.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "volta": {
    "node": "18.18.0",
    "npm": "10.8.1"
  }
}
